{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "packages/domain/src/**/*.ts",
    "packages/application/src/**/*.ts",
    "packages/protocol/src/**/*.ts",
    "packages/crypto/src/**/*.ts",
    "packages/exporters/src/**/*.ts",
    "!packages/*/src/**/*.d.ts",
    "!packages/domain/src/catalogue/templates.ts",
    "!packages/domain/src/catalogue/templates.en.ts",
    "!packages/application/src/ports/**"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 55
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "**/dist",
    "**/.output",
    ".wrangler",
    "test-results",
    "playwright-report",
    "reports",
    "coverage",
    ".claude",
    ".opencode",
    "openspec",
    "docs",
    "!apps/web/.nuxt/**"
  ],
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}

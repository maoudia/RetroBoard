{
  "name": "retroboard",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "description": "Real-time, anonymous, themeable retrospective board (Nuxt static + Cloudflare Workers + Durable Objects)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @retroboard/web dev",
    "dev:worker": "wrangler dev",
    "generate": "pnpm --filter @retroboard/web generate",
    "preview": "wrangler dev",
    "deploy": "pnpm generate && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:core": "node scripts/e2e-core.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch && pnpm knip && pnpm adr:check && pnpm test && openspec validate --all --strict",
    "spec": "openspec",
    "postinstall": "pnpm --filter @retroboard/web prepare && node scripts/commits/install-hooks.mjs",
    "arch": "depcruise packages apps/relay/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "mutation": "stryker run",
    "load:relay": "node scripts/load/relay-load.mjs",
    "adr:new": "node scripts/adr/new.mjs",
    "adr:index": "node scripts/adr/index.mjs",
    "adr:check": "node scripts/adr/check.mjs && markdownlint-cli2 \"docs/adr/*.md\"",
    "commits:check": "node scripts/commits/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "allure-vitest": "3.14.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jsqr": "1.4.0",
    "knip": "^6.43.0",
    "markdownlint-cli2": "0.24.0",
    "pngjs": "7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "ws": "8.22.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0"
}

{
  "name": "retroboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time, anonymous, themeable retrospective board (Nuxt static + Cloudflare Workers + Durable Objects)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:worker": "wrangler dev",
    "generate": "nuxt generate && node scripts/csp-hashes.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run generate && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/icon": "^2.5.1",
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.0.0",
    "happy-dom": "^20.0.11",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.152.0",
    "ws": "^8.18.0"
  }
}

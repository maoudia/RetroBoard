{
  "name": "retroboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time, anonymous, themeable retrospective board (Nuxt static + Cloudflare Workers + Durable Objects)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @retroboard/web dev",
    "dev:worker": "wrangler dev",
    "generate": "pnpm --filter @retroboard/web generate",
    "preview": "wrangler dev",
    "deploy": "pnpm generate && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch && pnpm knip && pnpm test && openspec validate --all --strict",
    "spec": "openspec",
    "postinstall": "pnpm --filter @retroboard/web prepare",
    "arch": "depcruise packages apps/relay/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0"
}

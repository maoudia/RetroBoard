{
  "name": "@retroboard/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "RetroBoard web app (Nuxt 4 static SPA): presentation, view models, adapters.",
  "scripts": {
    "dev": "node scripts/build-sync-workers.mjs && nuxt dev",
    "prepare": "nuxt prepare",
    "generate": "node scripts/build-sync-workers.mjs && nuxt generate && node scripts/csp-hashes.mjs && node scripts/asset-headers.mjs && node scripts/security-txt.mjs",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.155",
    "@mcp-b/global": "^6.2.0",
    "@nuxt/icon": "^2.6.2",
    "@pinia/nuxt": "^1.0.3",
    "@retroboard/application": "workspace:*",
    "@retroboard/crypto": "workspace:*",
    "@retroboard/domain": "workspace:*",
    "@retroboard/exporters": "workspace:*",
    "@retroboard/i18n": "workspace:*",
    "@retroboard/protocol": "workspace:*",
    "@retroboard/sync": "workspace:*",
    "@retroboard/themes": "workspace:*",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "uqr": "0.1.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "fake-indexeddb": "^6.2.8",
    "vue-tsc": "^3.3.14"
  }
}

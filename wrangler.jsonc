{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retroboard",
  "main": "apps/relay/src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "apps/web/.output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    // RelayRoom never calls ctx.storage; SQLite-backed classes are the only kind on the free plan.
    { "tag": "v2", "new_sqlite_classes": ["RelayRoom"] },
    // Protocol v1 boards were stored server-side; v3 deletes the class and all of its stored data (irreversible).
    { "tag": "v3", "deleted_classes": ["Room"] }
  ],
  // Workers Observability. Logs and traces carry event names and short room hashes only (never content).
  // redact_query_string: the WebSocket URL carries the room id in its query string; it must not reach logs.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "vars": {
    // Comma separated extra origins allowed to open the WebSocket. Used by `nuxt dev` on :3000.
    "ALLOWED_ORIGINS": "",
    // Chrome origin trial tokens for WebMCP, one per origin (public values). Expire 2027-03-30.
    // Registered at https://developer.chrome.com/origintrials; see docs/webmcp.md.
    "ORIGIN_TRIAL_TOKENS": {
      "retroboard.maoudia.com": "Ak2HSoz1jPkKE+Y2kmk5KEurr9LLRHMkwCfkDVTedRb9Jqmjld/eyLruTwa7yJ/uuL824HmQ8Rbn7PwigvB5dAMAAABWeyJvcmlnaW4iOiJodHRwczovL3JldHJvYm9hcmQubWFvdWRpYS5jb206NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTgwNjM2NDgwMH0=",
      "retroboard-dev.maoudia.com": "AswYY8ZvD05D8K3MZkeXvpM1+4g7eKwH0j7ZjZ9CsKPijVq02b5bbxdUoOrmWzOwigrw/XdzNTPqLTKqItuivgIAAABaeyJvcmlnaW4iOiJodHRwczovL3JldHJvYm9hcmQtZGV2Lm1hb3VkaWEuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJNQ1AiLCJleHBpcnkiOjE4MDYzNjQ4MDB9",
      "retroboard.www-maoudia-com.workers.dev": "Arv7apgclZhPs8i7ByNUr/xKCgbhxxnoIe1Dqq1wdUhdAjLox4kUV5qZ0/HZFhhhqvkmGBvQrrh8+8LQqsfspAQAAABmeyJvcmlnaW4iOiJodHRwczovL3JldHJvYm9hcmQud3d3LW1hb3VkaWEtY29tLndvcmtlcnMuZGV2OjQ0MyIsImZlYXR1cmUiOiJXZWJNQ1AiLCJleHBpcnkiOjE4MDYzNjQ4MDB9"
    }
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/e2e/**/*.ts",
        "scripts/**/*.mjs",
        "allurerc.mjs"
      ],
      "ignoreDependencies": [
        "allure-playwright",
        "allure-vitest"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{vue,ts}",
        "public/*.js",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@iconify-json/lucide"
      ]
    },
    "apps/relay": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "packages/domain": {
      "entry": [
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@iconify-json/lucide"
      ]
    },
    "packages/*": {
      "entry": [
        "test/**/*.ts"
      ]
    }
  },
  "ignore": [
    "**/worker-configuration.d.ts",
    "**/*.d.ts"
  ],
  "ignoreExportsUsedInFile": true
}

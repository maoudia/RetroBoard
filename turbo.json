{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/public/**"
      ]
    }
  }
}
